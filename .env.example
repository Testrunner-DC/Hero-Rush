VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 卡图资产库默认使用仓库同级 ../assets；只有需要改位置时才设置。
# HERO_RUSH_ASSET_ROOT=F:\Projects\Hero-Rush\assets
# 可选：发布到独立静态域名后配置；留空则使用同源 /card-assets。
VITE_CARD_ASSET_CDN=
VITE_CARD_ASSET_MANIFEST=/card-assets/card-assets.manifest.json
# 可选：留空时 HTTPS 页面自动使用同源 wss://<域名>/ws/。
VITE_BATTLE_V2_WS_URL=

# V2 对战服务开关。前端默认使用 V2 大厅；服务端仍需显式启用。
BATTLE_V2_ENABLED=false
BATTLE_V2_ENFORCE_CARD_POOL=false

# 最小化管理后台。用户名和 scrypt 结果只配置在部署环境；不要提交明文密码。
ADMIN_USERNAME=
ADMIN_PASSWORD_SCRYPT=
# 逗号分隔，只允许这些前端来源调用管理 API。
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
